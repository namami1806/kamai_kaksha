FROM node:20-alpine

WORKDIR /app

# Copy monorepo package files
COPY package*.json ./
COPY server/package*.json ./server/
COPY data/ ./data/

# Install server dependencies
WORKDIR /app/server
RUN npm install --production

# Copy server source code
COPY server/src ./src

EXPOSE 5001

CMD ["node", "src/index.js"]
