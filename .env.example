# ==============================================================================
# Kamai Kaksha (The Earning Classroom) - Environment Configuration
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MQTT Telemetry Broker
MQTT_PORT=1883
MQTT_WS_PATH=/mqtt

# Security & Authority Secrets
FACILITATOR_SECRET=your_facilitator_secret_here
ISSUER_DID=did:web:kamai-kaksha.example
ISSUER_NAME=Kamai Kaksha Skills Authority

# Optional External AI/STT APIs (If unset, built-in mock STT engine is used)
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# WHISPER_API_KEY=
